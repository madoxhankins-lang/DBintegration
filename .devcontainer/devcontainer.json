{
  "name": "DBE Integrations",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.dev.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/dbe",
  "postCreateCommand": "cd code/start && npm ci && npm run db:generate && npm run db:migrate",
  "forwardPorts": [3002],
  "customizations": {
    "vscode": {
      "extensions": ["bruno-api-client.bruno", "dbaeumer.vscode-eslint"]
    }
  }
}
